// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  usuario       String   @unique @db.VarChar(100)
  senha_hash    String   @map("senha_hash") @db.VarChar(255)
  nome_completo String?  @map("nome_completo") @db.VarChar(255)
  ativo         Boolean  @default(true)
  created_at    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  estufas EstufaUsuario[]

  @@map("usuario")
}

model EstufaUsuario {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  estufa_id          String    @map("estufa_id") @db.Uuid
  usuario_id         String    @map("usuario_id") @db.Uuid
  role               String    @db.VarChar(50)
  data_acesso_inicio DateTime  @default(now()) @map("data_acesso_inicio") @db.Timestamp(6)
  data_acesso_fim    DateTime? @map("data_acesso_fim") @db.Timestamp(6)
  estufa             Estufa    @relation(fields: [estufa_id], references: [id], onDelete: Cascade)
  usuario            Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("estufa_usuario")
}

model Estufa {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome            String   @db.VarChar(200)
  localizacao     String?  @db.VarChar(500)
  largura         Float
  altura          Float
  comprimento     Float
  volume_total    Float?   @map("volume_total")
  codigo_vinculo  String?  @unique @db.VarChar(100)
  status          String   @default("ativa") @db.VarChar(50)
  firmware_versao String?  @map("firmware_versao") @db.VarChar(50)
  created_at      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  usuarios EstufaUsuario[]
  modulos  Modulo[]

  @@map("estufa")
}

// Enum para tipos de módulos IoT
enum ModuloTipo {
  CO2
  IRRIGACAO
  ILUMINACAO
  CLIMA
  NUTRICAO
}

// Módulo IoT
model Modulo {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  estufa_id    String     @map("estufa_id") @db.Uuid
  tipo         ModuloTipo
  nome         String     @db.VarChar(100)
  ativo        Boolean    @default(true)
  configuracao Json?
  created_at   DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  estufa    Estufa    @relation(fields: [estufa_id], references: [id], onDelete: Cascade)
  sensores  Sensor[]
  atuadores Atuador[]

  @@map("modulo")
}

// Sensor (leituras)
model Sensor {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modulo_id      String    @map("modulo_id") @db.Uuid
  tipo           String    @db.VarChar(50)
  unidade        String    @db.VarChar(20)
  valor_atual    Float?    @map("valor_atual")
  valor_min      Float?    @map("valor_min")
  valor_max      Float?    @map("valor_max")
  ultima_leitura DateTime? @map("ultima_leitura") @db.Timestamp(6)

  modulo    Modulo            @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
  historico HistoricoSensor[]

  @@map("sensor")
}

// Histórico de sensores (para gráficos)
model HistoricoSensor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sensor_id String   @map("sensor_id") @db.Uuid
  valor     Float
  timestamp DateTime @default(now()) @db.Timestamp(6)

  sensor Sensor @relation(fields: [sensor_id], references: [id], onDelete: Cascade)

  @@index([sensor_id, timestamp])
  @@map("historico_sensor")
}

// Atuador (controles)
model Atuador {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modulo_id   String    @map("modulo_id") @db.Uuid
  tipo        String    @db.VarChar(50)
  nome        String    @db.VarChar(100)
  estado      Boolean   @default(false)
  modo        String    @default("manual") @db.VarChar(20)
  ultima_acao DateTime? @map("ultima_acao") @db.Timestamp(6)

  modulo Modulo @relation(fields: [modulo_id], references: [id], onDelete: Cascade)

  @@map("atuador")
}
