generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  username      String   @unique @db.VarChar(100)
  password_hash String   @db.VarChar(255)
  full_name     String?  @db.VarChar(255)
  role          Role     @default(USER)
  active        Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(6)

  products     Product[]
  userProducts UserProduct[]

  @@map("user")
}

model Product {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  name             String    @db.VarChar(200)
  description      String?   @db.VarChar(500)
  link_code        String?   @unique @db.VarChar(100)
  status           String    @default("active") @db.VarChar(50)
  firmware_version String?   @db.VarChar(50)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  user         User          @relation(fields: [user_id], references: [id])
  userProducts UserProduct[]

  @@map("product")
}

model UserProduct {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String    @db.Uuid
  user_id      String    @db.Uuid
  name         String?   @db.VarChar(100)
  role         String    @default("OWNER") @db.VarChar(50)
  client_id    String    @unique @db.VarChar(8)
  access_start DateTime  @default(now()) @db.Timestamp(6)
  access_end   DateTime? @db.Timestamp(6)

  // Configuração individual de thresholds
  ph_min  Float?
  ph_max  Float?
  ppm_min Float?
  ppm_max Float?

  // Estado dos dispositivos por instância
  relay_state          Boolean   @default(false)
  relay_last_action_at DateTime? @db.Timestamp(6)
  pump_state           Boolean   @default(false)
  pump_last_action_at  DateTime? @db.Timestamp(6)

  // Cache de leitura por instância
  ph_current      Float?
  ppm_current     Float?
  last_reading_at DateTime? @db.Timestamp(6)

  product  Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  readings Reading[]
  alerts   Alert[]

  @@map("user_product")
}

enum SensorType {
  PH
  PPM
}

model Reading {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_product_id String      @db.Uuid
  sensor_type     SensorType
  value           Float
  unit            String      @db.VarChar(20)
  recorded_at     DateTime    @default(now()) @db.Timestamp(6)

  userProduct UserProduct @relation(fields: [user_product_id], references: [id], onDelete: Cascade)

  @@index([user_product_id, sensor_type, recorded_at])
  @@map("reading")
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

model Alert {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_product_id String        @db.Uuid
  sensor_type     SensorType
  severity        AlertSeverity
  value           Float
  threshold       Float
  message         String        @db.VarChar(500)
  resolved        Boolean       @default(false)
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  resolved_at     DateTime?     @db.Timestamp(6)

  userProduct UserProduct @relation(fields: [user_product_id], references: [id], onDelete: Cascade)

  @@index([user_product_id, resolved, created_at])
  @@map("alert")
}
